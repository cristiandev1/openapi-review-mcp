{
  "name": "openapi-review-mcp",
  "version": "0.1.0",
  "description": "Local, Git-backed OpenAPI contract review for MCP coding assistants",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "eval:contracts": "node --test tests/evaluation.test.mjs",
    "demo": "node examples/order-api/create-demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "typescript": "5.9.3"
  }
}
